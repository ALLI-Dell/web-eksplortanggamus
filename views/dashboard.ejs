<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin & Database Center - Eksplor Tanggamus</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #0284c7;
      --primary-hover: #0369a1;
      --secondary: #10b981;
      --bg: #0f172a;
      --card-bg: #1e293b;
      --border: #334155;
      --text: #f8fafc;
      --text-muted: #94a3b8;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      padding-bottom: 50px;
    }
    .navbar {
      background: rgba(30, 41, 59, 0.9);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
      padding: 14px 0;
    }
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }
    .nav-wrap {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-family: 'Poppins', sans-serif;
      font-size: 1.25rem;
      font-weight: 700;
      color: #38bdf8;
      text-decoration: none;
    }
    .nav-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 18px;
      border-radius: 9999px;
      font-size: 0.9rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s ease;
    }
    .nav-btn-primary {
      background: #0284c7;
      color: white;
    }
    .nav-btn-primary:hover {
      background: #0369a1;
      transform: translateY(-1px);
    }
    .header-section {
      padding: 30px 0 20px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 16px;
    }
    .header-title h1 {
      font-size: 1.8rem;
      color: #fff;
    }
    .header-title p {
      color: var(--text-muted);
      margin-top: 4px;
      font-size: 0.95rem;
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 18px;
      margin-bottom: 30px;
    }
    .stat-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 20px;
      display: flex;
      align-items: center;
      gap: 18px;
    }
    .stat-icon {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
    }
    .stat-blue { background: rgba(2, 132, 199, 0.2); color: #38bdf8; }
    .stat-green { background: rgba(16, 185, 129, 0.2); color: #34d399; }
    .stat-amber { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }
    .stat-purple { background: rgba(168, 85, 247, 0.2); color: #c084fc; }
    .stat-val { font-size: 1.7rem; font-weight: 800; color: #fff; }
    .stat-lbl { color: var(--text-muted); font-size: 0.85rem; font-weight: 500; }
    .section-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 22px;
      margin-bottom: 28px;
      overflow: hidden;
    }
    .section-card-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 18px;
    }
    .section-card-title h3 {
      font-size: 1.15rem;
      display: flex;
      align-items: center;
      gap: 10px;
      color: #f1f5f9;
    }
    .table-wrap {
      overflow-x: auto;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.9rem;
    }
    th {
      padding: 12px 14px;
      background: rgba(15, 23, 42, 0.6);
      color: var(--text-muted);
      font-weight: 600;
      border-bottom: 1px solid var(--border);
    }
    td {
      padding: 12px 14px;
      border-bottom: 1px solid rgba(51, 65, 85, 0.6);
      vertical-align: middle;
    }
    tr:hover td {
      background: rgba(255, 255, 255, 0.02);
    }
    .badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 9999px;
      font-size: 0.78rem;
      font-weight: 600;
    }
    .badge-primary { background: rgba(2, 132, 199, 0.2); color: #38bdf8; border: 1px solid rgba(2, 132, 199, 0.4); }
    .badge-green { background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4); }
    .badge-star { color: #f59e0b; font-weight: 700; }
    .dest-thumb {
      width: 44px;
      height: 44px;
      border-radius: 8px;
      object-fit: cover;
    }
    .dest-row-info {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .api-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #1e293b;
      border: 1px solid var(--border);
      padding: 6px 12px;
      border-radius: 8px;
      font-family: monospace;
      font-size: 0.85rem;
      color: #38bdf8;
      text-decoration: none;
    }
    .api-badge:hover {
      background: #334155;
    }
  </style>
</head>
<body>

  <nav class="navbar">
    <div class="container nav-wrap">
      <a href="/" class="brand">
        <i class="fa-solid fa-compass"></i>
        <span>Eksplor Tanggamus</span>
        <span style="font-size:0.75rem; background:#0284c7; color:#fff; padding:2px 8px; border-radius:12px; font-weight:500;">Database Admin</span>
      </a>
      <div style="display:flex; gap:10px;">
        <a href="/data.json" target="_blank" class="api-badge"><i class="fa-solid fa-code"></i> /data.json API</a>
        <a href="/" class="nav-btn nav-btn-primary"><i class="fa-solid fa-globe"></i> Buka Website Utama</a>
      </div>
    </div>
  </nav>

  <div class="container">
    <div class="header-section">
      <div class="header-title">
        <h1>📊 Data Management Center</h1>
        <p>Database aktif: <strong>SQLite (Prisma ORM)</strong> • Menyimpan Destinasi, Kuliner, Rute, Ulasan, dan Budget Trip</p>
      </div>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon stat-blue"><i class="fa-solid fa-location-dot"></i></div>
        <div>
          <div class="stat-val"><%= stats.totalDestinasi %></div>
          <div class="stat-lbl">Destinasi Wisata Terdaftar</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-green"><i class="fa-solid fa-utensils"></i></div>
        <div>
          <div class="stat-val"><%= stats.totalKuliner %></div>
          <div class="stat-lbl">Kuliner & Oleh-Oleh Khas</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-amber"><i class="fa-solid fa-comments"></i></div>
        <div>
          <div class="stat-val"><%= stats.totalUlasan %></div>
          <div class="stat-lbl">Ulasan Wisatawan Tersimpan</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-purple"><i class="fa-solid fa-receipt"></i></div>
        <div>
          <div class="stat-val"><%= stats.totalRencana %></div>
          <div class="stat-lbl">Rencana Liburan Dihitung</div>
        </div>
      </div>
    </div>

    <!-- Table: Destinasi Wisata -->
    <div class="section-card">
      <div class="section-card-title">
        <h3><i class="fa-solid fa-map-location-dot" style="color:#38bdf8;"></i> Daftar Destinasi Wisata di Database</h3>
        <span class="badge badge-primary"><%= destinations.length %> Destinasi</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Destinasi</th>
              <th>Kategori</th>
              <th>Lokasi</th>
              <th>Tiket Masuk</th>
              <th>Rating</th>
              <th>Status</th>
              <th>Ulasan Masuk</th>
            </tr>
          </thead>
          <tbody>
            <% destinations.forEach(item => { %>
              <tr>
                <td><strong>#<%= item.id %></strong></td>
                <td>
                  <div class="dest-row-info">
                    <img src="/Gambar/<%= item.gambar %>" class="dest-thumb" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=100&q=80';">
                    <div>
                      <strong><%= item.nama %></strong>
                      <div style="font-size:0.75rem; color:var(--text-muted);"><%= item.namaEn || '' %></div>
                    </div>
                  </div>
                </td>
                <td><span class="badge badge-primary"><%= item.kategori %></span></td>
                <td><%= item.lokasi %></td>
                <td><%= item.hargaTiket === 0 ? 'Gratis' : 'Rp ' + Number(item.hargaTiket).toLocaleString('id-ID') %></td>
                <td><span class="badge-star">★ <%= item.rating %></span></td>
                <td>
                  <% if (item.rekomendasi) { %>
                    <span class="badge badge-green">🔥 Rekomendasi</span>
                  <% } else { %>
                    <span style="color:var(--text-muted); font-size:0.8rem;">Standar</span>
                  <% } %>
                </td>
                <td><strong><%= item.reviews.length %> Ulasan</strong></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Table: Ulasan Wisatawan Terbaru -->
    <div class="section-card">
      <div class="section-card-title">
        <h3><i class="fa-solid fa-comments" style="color:#f59e0b;"></i> Ulasan Wisatawan Terbaru (Disimpan di SQLite)</h3>
        <span class="badge badge-green"><%= recentReviews.length %> Ulasan Terbaru</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Pengulas</th>
              <th>Destinasi</th>
              <th>Rating</th>
              <th>Komentar</th>
              <th>Asal Kota</th>
              <th>Waktu</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentReviews.length === 0) { %>
              <tr>
                <td colspan="6" style="text-align:center; color:var(--text-muted); padding:20px;">Belum ada ulasan yang tersimpan.</td>
              </tr>
            <% } else { %>
              <% recentReviews.forEach(rev => { %>
                <tr>
                  <td><strong><%= rev.authorName %></strong></td>
                  <td><span class="badge badge-primary"><%= rev.destination ? rev.destination.nama : '-' %></span></td>
                  <td><span class="badge-star">★ <%= rev.rating %></span></td>
                  <td><em>"<%= rev.comment %>"</em></td>
                  <td><%= rev.origin || 'Wisatawan' %></td>
                  <td style="color:var(--text-muted); font-size:0.8rem;"><%= new Date(rev.createdAt).toLocaleDateString('id-ID') %></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Table: Rencana Liburan (Trip Plan) -->
    <div class="section-card">
      <div class="section-card-title">
        <h3><i class="fa-solid fa-calculator" style="color:#10b981;"></i> Rencana Anggaran Liburan (Trip Budget Plans) Tersimpan</h3>
        <span class="badge badge-green"><%= recentTripPlans.length %> Rencana</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Kode Plan</th>
              <th>Nama Wisatawan</th>
              <th>Orang / Durasi</th>
              <th>Moda Transportasi</th>
              <th>Akomodasi</th>
              <th>Total Biaya</th>
              <th>Per Orang</th>
              <th>Tanggal Dibuat</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentTripPlans.length === 0) { %>
              <tr>
                <td colspan="8" style="text-align:center; color:var(--text-muted); padding:20px;">Belum ada rencana perjalanan yang tersimpan. Coba gunakan fitur kalkulator di halaman utama!</td>
              </tr>
            <% } else { %>
              <% recentTripPlans.forEach(plan => { %>
                <tr>
                  <td><span class="badge badge-primary"><strong><%= plan.planCode %></strong></span></td>
                  <td><%= plan.travelerName %></td>
                  <td><%= plan.travelersCount %> Orang • <%= plan.durationDays %> Hari</td>
                  <td><%= plan.transportType %></td>
                  <td><%= plan.accommodationType %></td>
                  <td><strong>Rp <%= Number(plan.totalCost).toLocaleString('id-ID') %></strong></td>
                  <td style="color:#34d399;">Rp <%= Number(plan.costPerPerson).toLocaleString('id-ID') %></td>
                  <td style="color:var(--text-muted); font-size:0.8rem;"><%= new Date(plan.createdAt).toLocaleDateString('id-ID') %></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Table: High Score Mini Games -->
    <div class="section-card">
      <div class="section-card-title">
        <h3><i class="fa-solid fa-gamepad" style="color:#c084fc;"></i> Rekor Skor Mini Game (Leaderboard)</h3>
        <span class="badge badge-primary"><%= topGameScores.length %> Skor Tertinggi</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Game</th>
              <th>Pemain</th>
              <th>Skor Akhir</th>
              <th>Detail</th>
              <th>Waktu</th>
            </tr>
          </thead>
          <tbody>
            <% if (topGameScores.length === 0) { %>
              <tr>
                <td colspan="5" style="text-align:center; color:var(--text-muted); padding:20px;">Belum ada catatan skor mini game.</td>
              </tr>
            <% } else { %>
              <% topGameScores.forEach(score => { %>
                <tr>
                  <td><span class="badge badge-primary"><%= score.gameType %></span></td>
                  <td><strong><%= score.playerName %></strong></td>
                  <td><strong style="color:#fbbf24;"><%= score.score %> Poin</strong></td>
                  <td style="color:var(--text-muted);"><%= score.detail || '-' %></td>
                  <td style="color:var(--text-muted); font-size:0.8rem;"><%= new Date(score.createdAt).toLocaleDateString('id-ID') %></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>

</body>
</html>
